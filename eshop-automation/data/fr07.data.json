{
  "positiveCases": {
    "add_single": {
      "productId": 1,
      "productName": "iPhone 15 Pro Max",
      "price": 30000000,
      "quantity": 1,
      "expectedTotal": "30,000,000 ₫"
    },
    "add_multiple_same": {
      "productId": 1,
      "productName": "iPhone 15 Pro Max",
      "price": 30000000,
      "quantity": 2,
      "expectedTotal": "60,000,000 ₫"
    },
    "add_multiple_different": {
      "items": [
        {
          "productId": 1,
          "productName": "iPhone 15 Pro Max",
          "price": 30000000,
          "quantity": 1
        },
        {
          "productId": 2,
          "productName": "Samsung Galaxy S24",
          "price": 28000000,
          "quantity": 1
        }
      ],
      "expectedCombinedTotal": "58,000,000 ₫"
    },
    "update_quantity": {
      "productId": 1,
      "initialQuantity": 1,
      "updatedQuantity": 3,
      "expectedTotal": "90,000,000 ₫"
    }
  },
  "emptyCart": {
    "expectedMessage": "Giỏ hàng của bạn đang trống"
  },
  "negativeCases": {
    "invalidQuantities": [
      0,
      -1,
      "abc",
      ""
    ],
    "expectedFallbackValue": "1"
  },
  "edgeCases": {
    "deleteConfirm": {
      "expectedDialog": true
    }
  },
  "apiEndpoints": {
    "cart": "/api/cart"
  }
